# Caddyfile para damascena.dev (MobiNovo em /projetos/mobilita)
#
# NOTA: Se o /etc/caddy/Caddyfile principal da VPS já possuir um bloco global
# `{ servers { trusted_proxies ... } }` (ex.: do projeto screenshare), mantenha
# apenas UM bloco global no arquivo principal e importe/copie somente o bloco
# `damascena.dev { ... }` abaixo.
#
# TLS: Compatível com Cloudflare Proxy (SSL/TLS: Full (strict)).
# Com Caddy gerenciando Let's Encrypt automaticamente, mantenha HTTP-01/TLS-ALPN
# acessível ou configure Cloudflare Origin Certificate no bloco tls se preferir.

{
	servers {
		# Cloudflare IPv4 + IPv6 ranges (https://www.cloudflare.com/ips/)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

damascena.dev {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self' https://wa.me https://web.whatsapp.com; frame-ancestors 'none'"
		-Server
	}

	# Garante barra final para resolução correta de assets relativos
	redir /projetos/mobilita /projetos/mobilita/ 308

	# Site estático Mobilità Transportes servido direto pelo Caddy (sem processo)
	handle_path /projetos/mobilita/* {
		root * /opt/sites/mobilita

		@static_assets path /assets/* *.css *.js *.webp *.png *.jpg *.jpeg *.svg *.ico *.woff2
		header @static_assets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

		@html path / /index.html
		header @html Cache-Control "public, max-age=300, must-revalidate"

		@hidden path */.*
		respond @hidden 404

		file_server
	}

	# SEO na raiz do domínio (robots.txt e sitemap.xml)
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		respond `User-agent: *
Allow: /
Sitemap: https://damascena.dev/sitemap.xml
` 200
	}

	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://damascena.dev/projetos/mobilita/</loc>
  </url>
</urlset>
` 200
	}

	# Placeholder simples na raiz para portfólio futuro
	handle / {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300"
		respond "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>damascena.dev</title></head><body style=\"font-family:system-ui,-apple-system,sans-serif;max-width:42rem;margin:4rem auto;padding:0 1.25rem;line-height:1.6;color:#111\"><h1>damascena.dev</h1><p>Portfólio em construção.</p><p>Projetos publicados:</p><ul><li><a href=\"/projetos/mobilita/\">Mobilità Transportes</a></li></ul></body></html>" 200
	}

	handle {
		respond "Not found" 404
	}

	# 404 amigável apenas sob /projetos/mobilita (404.html usa <base href> do subpath)
	handle_errors {
		@mobilita404 {
			expression {err.status_code} == 404
			path /projetos/mobilita/*
		}
		handle @mobilita404 {
			rewrite * /404.html
			root * /opt/sites/mobilita
			file_server {
				status 404
			}
		}
	}
}
